datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String?
  password          String?
  googleId          String?           @unique
  avatar            String?
  role              String            @default("USER")
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  submittedNovels   Novel[]           @relation("SubmittedBy")
  readingProgresses ReadingProgress[]
  reports           Report[]
  likes             NovelLike[]
  bookshelves       Bookshelf[]
  chapterBookmarks  ChapterBookmark[]
  auditLogs         AuditLog[]
}

model Author {
  id        String    @id @default(uuid())
  name      String    @unique
  bio       String?
  avatar    String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  novels    Novel[]
}

model Novel {
  id                String            @id @default(uuid())
  titleEn           String
  titleTh           String
  description       String?
  coverUrl          String?
  sourceUrl         String
  category          String?
  genre             String?
  totalChapters     Int               @default(0)
  translationStatus String            @default("COMPLETED")
  viewCount         Int               @default(0)
  likeCount         Int               @default(0)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  authorId    String?
  author      Author?   @relation(fields: [authorId], references: [id])

  createdById String?
  createdBy   User?     @relation("SubmittedBy", fields: [createdById], references: [id])

  fandomId    String?
  fandom      Fandom?   @relation(fields: [fandomId], references: [id], onDelete: SetNull)

  chapters    Chapter[]
  reports     Report[]
  likes       NovelLike[]
  bookshelves Bookshelf[]
  glossaries  NovelGlossary[]
}

model Chapter {
  id                  String            @id @default(uuid())
  chapterNumber       Int               @default(1)
  titleEn             String
  titleTh             String
  contentEn           String?
  contentTh           String?
  contentThGoogle     String?
  contentThPolished   String?
  status              String            @default("TOC_ONLY")
  errorCode           String            @default("NONE")
  errorMessage        String?
  sourceHash          String?
  originalUrl         String

  // Observability & Metrics
  fetchDurationMs     Int?
  translateDurationMs Int?
  polishDurationMs    Int?
  translationProvider String?           @default("GOOGLE_CLOUD_API")
  translationVersion  Int               @default(1)
  llmProvider         String?
  llmModel            String?
  promptVersion       String?
  glossaryVersion     Int?

  fetchedAt           DateTime?
  translatedAt        DateTime?
  polishedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  novelId             String
  novel               Novel             @relation(fields: [novelId], references: [id], onDelete: Cascade)

  jobs                ChapterJob[]
  readingProgresses   ReadingProgress[]
  reports             Report[]
  chapterBookmarks    ChapterBookmark[]

  @@unique([novelId, chapterNumber])
  @@index([novelId, status])
}

model ChapterJob {
  id             String     @id @default(uuid())
  chapterId      String
  jobType        String     // "FETCH_AND_TRANSLATE", "POLISH"
  status         String     @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  workerId       String?
  attempts       Int        @default(0)
  maxAttempts    Int        @default(3)
  executionCount Int        @default(1)
  lockedAt       DateTime?
  lockedUntil    DateTime?
  errorCode      String     @default("NONE")
  errorDetail    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  chapter        Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, jobType])
  @@index([status, lockedUntil])
}

model ReadingProgress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  scrollPercent Float    @default(0)
  lastReadAt    DateTime @default(now())

  @@unique([userId, chapterId])
}

model Report {
  id          String   @id @default(uuid())
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novelId     String?
  novel       Novel?   @relation(fields: [novelId], references: [id], onDelete: SetNull)

  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model NovelLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, novelId])
}

model Bookshelf {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, novelId])
}

model ChapterBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, chapterId])
}

model WhitelistedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("USER")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InviteRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  note      String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model NovelGlossary {
  id               String               @id @default(uuid())
  novelId          String
  canonicalEn      String
  canonicalTh      String
  category         String?
  entityType       String               @default("CHARACTER")
  modelConfidence  Float                @default(1.0)
  validationStatus String               @default("PENDING")
  isLocked         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  novel            Novel                @relation(fields: [novelId], references: [id], onDelete: Cascade)
  aliases          NovelGlossaryAlias[]

  @@unique([novelId, canonicalEn])
  @@index([novelId, entityType])
}

model NovelGlossaryAlias {
  id          String        @id @default(uuid())
  glossaryId String
  aliasEn     String
  createdAt   DateTime      @default(now())

  glossary    NovelGlossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@unique([glossaryId, aliasEn])
  @@index([aliasEn])
}

// Shared term table for fanfic of the same source (Naruto, Harry Potter, ...).
// Admin-curated via "promote" from a novel glossary, so no lock/validation fields.
model Fandom {
  id        String           @id @default(uuid())
  name      String           @unique
  createdAt DateTime         @default(now())

  novels    Novel[]
  terms     FandomGlossary[]
}

model FandomGlossary {
  id          String   @id @default(uuid())
  fandomId    String
  canonicalEn String
  canonicalTh String
  category    String?
  entityType  String   @default("CHARACTER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fandom      Fandom   @relation(fields: [fandomId], references: [id], onDelete: Cascade)

  @@unique([fandomId, canonicalEn])
}

model SystemLock {
  key         String   @id
  ownerId     String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

// Runtime key-value config (e.g. ai.provider) so admin can switch AI provider without editing env.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

# Database Connection (SQLite / PostgreSQL)
DATABASE_URL="file:./dev.db"

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="noveltrans_db"
POSTGRES_PORT=5432

# Google Gemini API Key & Model for AI Literary Thai Translation
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# Authentication & JWT Secret (minimum 32 characters)
JWT_SECRET="your_jwt_secret_key_here"

# Server & Application URL
APP_URL="http://localhost:9000"
NEXT_PUBLIC_APP_URL="http://localhost:9000"
HOST="localhost"
PORT=9000

# Google OAuth 2.0 (Login with Google)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# OpenRouter (OpenAI-compatible). Free models end with ":free".
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.8-27b:free"
